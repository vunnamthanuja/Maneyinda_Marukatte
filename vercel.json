{
  "functions": {
    "api/index.js": {
      "includeFiles": "{css/**,js/**,assets/**,index.html,public/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js?__path=$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.js?__upload=$1"
    }
  ]
}