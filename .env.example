# =====================================================================
# MANEYINDA MARUKATTE - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and adjust variables as needed for deployment
# =====================================================================

# Server Port
PORT=5000

# Environment Mode (development | production)
NODE_ENV=development

# JWT Cryptographic Signing Secret
JWT_SECRET=maneyinda_marukatte_secure_jwt_secret_key_2026

# Administrator Configuration (Used by seed engine)
ADMIN_EMAIL=admin@marukatte.internal
ADMIN_INITIAL_PASSWORD=Admin@Marukatte2026!

# Password Hashing Salt
PASSWORD_SALT=maneyinda_salt_2026

# =====================================================================
# REAL TRANSACTIONAL EMAIL DELIVERY (RESEND API)
# =====================================================================
# 1. Sign up for free at https://resend.com (3,000 emails/month free)
# 2. Create an API Key in your Resend Dashboard (begins with 're_')
# 3. For local development, onboarding@resend.dev sends to your registered Resend email
# 4. For production, add & verify your domain (e.g. verify@maneyinda.com)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=Maneyindha Marukatte <onboarding@resend.dev>

# Demo OTP bypass for automated test suites / local offline dev without API key
# Set to 'false' in production to require real email delivery exclusively
ALLOW_DEMO_OTP=true
