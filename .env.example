# =====================================================================
# MANEYINDA MARUKATTE - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and adjust variables as needed for deployment
# =====================================================================

# Server Port
PORT=5000

# Environment Mode (development | production)
NODE_ENV=development

# JWT Cryptographic Signing Secret
JWT_SECRET=maneyinda_marukatte_secure_jwt_secret_key_2026

# Administrator Configuration (Used by seed engine)
ADMIN_EMAIL=admin@marukatte.internal
ADMIN_INITIAL_PASSWORD=Admin@Marukatte2026!

# Password Hashing Salt
PASSWORD_SALT=maneyinda_salt_2026

# =====================================================================
# REAL TRANSACTIONAL EMAIL DELIVERY PROVIDER
# Configure ONE of the three options below in your .env file:
# =====================================================================

# --- OPTION 1: RESEND API (Recommended) ---
# Sign up at https://resend.com (free 3,000 emails/month).
# Note: onboarding@resend.dev free sandbox domain can only send to your own registered email.
# To send to any customer email (e.g. Gmail/Outlook), verify a domain at https://resend.com/domains.
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=Maneyindha Marukatte <onboarding@resend.dev>

# --- OPTION 2: GMAIL SMTP (Easiest to deliver to ANY email without a domain!) ---
# 1. In your Google Account: Security -> 2-Step Verification -> App Passwords
# 2. Create an App Password for 'Mail' (gives a 16-letter code)
# 3. Uncomment and fill:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_character_app_password
# EMAIL_FROM=Maneyindha Marukatte <your_email@gmail.com>

# --- OPTION 3: BREVO API (300 emails/day free) ---
# Sign up at https://brevo.com and get your API Key (begins with 'xkeysib-')
# BREVO_API_KEY=xkeysib-your_brevo_api_key_here
# EMAIL_FROM=Maneyindha Marukatte <your_verified_sender@domain.com>

# Set to 'false' in production to enforce real email delivery strictly
ALLOW_DEMO_OTP=true
